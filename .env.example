# Telegram: message @BotFather -> /newbot -> copy the token it gives you
TELEGRAM_BOT_TOKEN=

# Gemini: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Model names and free-tier quotas change over time -- run
# `python -m scripts.check_setup` if this stops working, it lists every
# model your key actually has generateContent access to.
GEMINI_MODEL=gemini-3.1-flash-lite

# CalorieNinjas (api-ninjas.com): free account, 10,000 req/month --
# note that as of mid-2026 their free tier gates core fields (calories
# etc.) behind a premium subscription, so expect this to often come back
# empty and fall through to USDA/Gemini. Still worth having for whatever
# it does return.
CALORIENINJAS_API_KEY=

# USDA FoodData Central: the shared DEMO_KEY is easily exhausted (it's a
# global rate limit, not per-user) -- get your own free key in seconds,
# no approval needed, at https://fdc.nal.usda.gov/api-key-signup for
# 1,000 req/hour.
USDA_API_KEY=DEMO_KEY

# Open Food Facts needs no key -- nothing to set here.

# After filling this in, run `python -m scripts.check_setup` to verify
# every key actually works before starting the bot/dashboard.

# Where the SQLite file lives (default: ./data/nutrition.db)
DB_PATH=

# Port for the Flask dashboard API (your other app is on 8000, so this
# defaults to 8001 to avoid clashing with it)
API_PORT=8001

# Hours offset from UTC for your local day boundaries, e.g. 5.5 for IST
LOCAL_UTC_OFFSET_HOURS=0
